{
  "schemaVersion": 1,
  "id": "danluan.apple-menu",
  "name": "Apple menu",
  "version": "1.0.0",
  "author": "Daniel Luan",
  "description": "Omarchy menu with an Apple logo button (Liquid Glass theme)",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
